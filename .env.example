# Copie para .env.local (NUNCA commite .env.local). Valores abaixo são exemplos.

# Hosts do Ollama que o SERVIDOR pode chamar (anti-SSRF). Lista separada por vírgula, "host" ou "host:porta".
# Se vazio, só o Ollama local (localhost:11434) é aceito.
OLLAMA_ALLOWED_HOSTS=localhost:11434
# Exemplo com túnel: OLLAMA_ALLOWED_HOSTS=localhost:11434,seu-subdominio.ngrok-free.dev
