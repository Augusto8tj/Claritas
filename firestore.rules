/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. All data is
 * sandboxed within a user's own data tree, and a user can only ever access documents
 * that belong to them. There is no concept of public or shared data.
 *
 * Data Structure: The entire database is structured hierarchically under the `/users`
 * collection. Each user has a document keyed by their Firebase Auth UID (`/users/{userId}`).
 * All related data, such as financial accounts, transactions, goals, and AI insights,
 * are stored in subcollections under that specific user's document.
 *
 * Key Security Decisions:
 * - User Enumeration is Disallowed: Listing the top-level `/users` collection is
 *   explicitly forbidden to protect user privacy.
 * - Strict Data Sandboxing: A user's authentication credentials (`request.auth.uid`)
 *   are the sole gatekeeper for accessing any document. Rules consistently check that
 *   the `userId` in the document path matches the authenticated user's ID.
 * - No Global Roles: There are no admin or privileged roles; all users are subject
 *   to the same ownership rules.
 *
 * Denormalization for Authorization: To ensure fast and simple authorization checks,
 * this security model requires that all documents within a user's subcollections
 * (e.g., FinancialAccount, Transaction) contain a denormalized `userId` field.
 * This `userId` field must match the `{userId}` from the document path, allowing for
 * direct ownership checks without needing slow, expensive `get()` calls to parent

 * documents.
 *
 * Structural Segregation: By nesting all user-specific data into separate subcollections
 * under `/users/{userId}`, we create a clear and secure separation between each
 * user's data. This prevents accidental data leakage and simplifies list queries, as
 * they are naturally scoped to the requesting user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the requesting user is the owner of the document based on the path.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks for ownership on an existing document, critical for update/delete.
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Controls access to a user's own profile document.
     * @path /users/{userId}
     * @allow A user (auth.uid='user123') creating their own profile at /users/user123. (create)
     * @allow A user (auth.uid='user123') reading their own profile from /users/user123. (get)
     * @deny An anonymous user trying to create a profile. (create)
     * @deny A user (auth.uid='userABC') trying to read another user's profile at /users/user123. (get)
     * @deny Any user trying to list all user profiles. (list)
     * @principle Restricts access to a user's own data tree and enforces self-creation.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Controls access to a user's financial accounts.
       * @path /users/{userId}/financialAccounts/{accountId}
       * @allow A user (auth.uid='user123') creating a new financial account in their own subcollection. (create)
       * @allow A user (auth.uid='user123') listing all of their own financial accounts. (list)
       * @deny A user (auth.uid='userABC') trying to read a financial account at /users/user123/financialAccounts/acc456. (get)
       * @principle Enforces document ownership and validates relational integrity via a denormalized userId.
       */
      match /financialAccounts/{accountId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Controls access to a user's financial transactions.
       * @path /users/{userId}/transactions/{transactionId}
       * @allow A user (auth.uid='user123') deleting a transaction from their own subcollection. (delete)
       * @allow A user (auth.uid='user123') listing all of their own transactions. (list)
       * @deny An anonymous user trying to create a transaction. (create)
       * @deny A user (auth.uid='userABC') trying to update a transaction at /users/user123/transactions/trans789. (update)
       * @principle Enforces document ownership for all operations on sensitive financial data.
       */
      match /transactions/{transactionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId); // NOTE: Assumes a 'userId' field will be denormalized onto the transaction document for consistency.
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Controls access to a user's financial goals.
       * @path /users/{userId}/financialGoals/{goalId}
       * @allow A user (auth.uid='user123') creating a new financial goal in their own subcollection. (create)
       * @allow A user (auth.uid='user123') updating a financial goal in their own subcollection. (update)
       * @deny A user (auth.uid='userABC') trying to read a financial goal at /users/user123/financialGoals/goal456. (get)
       * @principle Enforces document ownership and validates relational integrity via a denormalized userId.
       */
      match /financialGoals/{goalId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Controls access to a user's AI-generated insights.
       * @path /users/{userId}/aiInsights/{insightId}
       * @allow A user (auth.uid='user123') creating a new AI insight in their own subcollection. (create)
       * @allow A user (auth.uid='user123') listing their own AI insights. (list)
       * @deny A user (auth.uid='userABC') trying to delete an insight at /users/user123/aiInsights/insight789. (delete)
       * @principle Enforces document ownership and validates relational integrity via a denormalized userId.
       */
      match /aiInsights/{insightId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}