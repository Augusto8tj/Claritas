/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. All data is considered private and is only accessible by the authenticated user who owns it. The default security posture is to deny all access, granting permissions explicitly on a per-collection basis.
 *
 * Data Structure: All application data is nested within a top-level `users` collection. Each user's data, including their profile, financial accounts, transactions, goals, and AI insights, is stored in documents and subcollections under their unique user document (`/users/{userId}`). This hierarchical structure is the foundation of the security model.
 *
 * Key Security Decisions:
 * - User Enumeration Prevention: Listing documents in the top-level `/users` collection is explicitly disallowed to prevent attackers from discovering all user IDs in the system.
 * - Path-Based Security: All authorization decisions are made by comparing the authenticated user's UID (`request.auth.uid`) with the `{userId}` wildcard in the document path. This is a highly performant and secure pattern.
 * - No Public Data: There are no public collections. All data requires user authentication and ownership for access.
 *
 * Denormalization for Authorization: This ruleset relies on path-based ownership, which is very efficient. To ensure data integrity, subcollection documents (like FinancialAccount) are expected to contain a `userId` field that matches the `{userId}` in the path. This is validated on create and enforced as immutable on update, preventing documents from being moved or associated with the wrong user.
 *
 * Structural Segregation: The data model naturally segregates each user's data into their own document tree, starting at `/users/{userId}`. This makes it impossible for one user's queries to accidentally access another user's data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user's UID matches the document's owner UID from the path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * For update/delete operations, checks ownership and ensures the document already exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * On create, validates that the UserProfile document's internal `id` field matches the user's UID.
     */
    function isValidUserProfileCreate(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * On update, ensures the UserProfile's internal `id` field cannot be changed.
     */
    function isImmutableUserProfileUpdate() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * On create, validates that a subcollection document's internal `userId` field matches the owner's UID from the path.
     */
    function isValidOwnedDocCreate(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * On update, ensures a subcollection document's `userId` field cannot be changed.
     */
    function isImmutableOwnedDocUpdate() {
      return request.resource.data.userId == resource.data.userId;
    }

    // --------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------

    /**
     * @description Manages user profile documents and all their subcollections.
     * @path /users/{userId}
     */
    match /users/{userId} {
      /**
       * @description Governs access to the user's own profile document.
       * @allow (get) An authenticated user can read their own profile.
       * @deny (list) No one can list all user profiles in the database.
       */
      allow get: if isOwner(userId);
      allow list: if false; // Explicitly deny listing all users
      allow create: if isOwner(userId) && isValidUserProfileCreate(userId);
      allow update: if isExistingOwner(userId) && isImmutableUserProfileUpdate();
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages a user's private financial accounts.
       * @path /users/{userId}/financialAccounts/{accountId}
       */
      match /financialAccounts/{accountId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOwnedDocCreate(userId);
        allow update: if isExistingOwner(userId) && isImmutableOwnedDocUpdate();
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Manages a user's private transactions.
       * @path /users/{userId}/transactions/{transactionId}
       */
      match /transactions/{transactionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Manages a user's private financial goals.
       * @path /users/{userId}/financialGoals/{financialGoalId}
       */
      match /financialGoals/{financialGoalId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOwnedDocCreate(userId);
        allow update: if isExistingOwner(userId) && isImmutableOwnedDocUpdate();
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Manages a user's private AI-generated insights.
       * @path /users/{userId}/aiInsights/{aiInsightId}
       */
      match /aiInsights/{aiInsightId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOwnedDocCreate(userId);
        allow update: if isExistingOwner(userId) && isImmutableOwnedDocUpdate();
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Manages a user's private trading data and performance logs.
       * @path /users/{userId}/trading_data/{document=**}
       */
      match /trading_data/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      /**
       * @description Manages a user's private trade decision audit logs.
       * @path /users/{userId}/decision_logs/{document=**}
       */
      match /decision_logs/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
       /**
       * @description Manages a user's private settings.
       * @path /users/{userId}/settings/{document=**}
       */
      match /settings/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
