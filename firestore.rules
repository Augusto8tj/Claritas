rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se o utilizador autenticado é o dono do documento
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Regra para o próprio documento de perfil do utilizador
      allow get, create, update: if isOwner(userId);

      // --- REGRAS EXPLÍCITAS PARA SUBCOLEÇÕES ---

      // Regra para finanças pessoais
      match /transactions/{transactionId} { allow read, list, write, delete: if isOwner(userId); }
      match /goals/{goalId} { allow read, list, write, delete: if isOwner(userId); }
      match /settings/{settingId} { allow read, list, write, delete: if isOwner(userId); }
      
      // Regra para logs de auditoria V2.5
      match /decision_logs/{logId} { allow read, list, write, delete: if isOwner(userId); }

      // Regra para logs de auditoria V3
      match /decision_logs_v3/{logId} { allow read, list, write, delete: if isOwner(userId); }
      
      // Regra para dados de trading V1
      match /trading_data/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      // Regra para dados de trading V2.5
      match /trading_data_v2/{docId} {
          allow read, write: if isOwner(userId);
      }

      // Regra para dados de trading V3
      match /trading_data_v3/{docId} {
          allow read, write: if isOwner(userId);
      }
    }
  }
}
