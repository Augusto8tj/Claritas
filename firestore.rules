rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se o utilizador autenticado é o dono do documento
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Regra para o próprio documento de perfil do utilizador
      allow get, create, update: if isOwner(userId);

      // Regra CURINGA para TODAS as subcoleções de um utilizador.
      // Esta regra única e poderosa garante que um utilizador autenticado
      // tenha acesso total (leitura, escrita, etc.) a qualquer documento
      // dentro de qualquer subcoleção que pertença ao seu próprio perfil.
      // Resolve os problemas de acesso para /transactions, /goals, /settings,
      // /decision_logs, e todas as versões de /trading_data.
      match /{subcollection}/{docId} {
        allow read, list, write, delete: if isOwner(userId);
      }
    }
  }
}
